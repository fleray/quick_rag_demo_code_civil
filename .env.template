# ─────────────────────────────────────────────────────────────────────────────
# .env.template  –  Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Couchbase Capella ─────────────────────────────────────────────────────────
COUCHBASE_CONNECTION_STRING=couchbases://cb.YOUR_CB_CLUSTER.cloud.couchbase.com
COUCHBASE_USERNAME=Administrator
COUCHBASE_PASSWORD=password

# ── Couchbase Namespace (source data) ─────────────────────────────────────────
COUCHBASE_BUCKET=code_civil
COUCHBASE_SCOPE=livres_compiles
COUCHBASE_COLLECTION=law_articles

# ── Vector Search ─────────────────────────────────────────────────────────────
# Name of the FTS vector index on law_articles (see indexes/law_articles_vector_index.json)
COUCHBASE_INDEX_NAME=law_articles_vector_index

# Number of articles to retrieve per query
RETRIEVER_K=5

# ── Cache Collections (same bucket / scope) ───────────────────────────────────
# Exact-match conversational cache
COUCHBASE_CACHE_COLLECTION=conv_cache

# Semantic cache collection + its FTS vector index
COUCHBASE_SEMANTIC_CACHE_COLLECTION=semantic_cache
COUCHBASE_SEMANTIC_CACHE_INDEX=semantic_cache_index

# Similarity threshold for semantic cache hits (0.0 – 1.0)
SEMANTIC_CACHE_SCORE_THRESHOLD=0.85

# ── Model Selection ───────────────────────────────────────────────────────────
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
